# --- App identity / politeness (Cycle 1+) ---
# Descriptive User-Agent + contact sent to upstreams (PRD politeness).
# Contact = jesus@jodaz.xyz (also the upstream-outreach + later opt-out/abuse address).
# A dedicated abuse/opt-out mailbox can replace this later without code changes.
REUNIR_USER_AGENT="ReunirBot/0.1 (+mailto:jesus@jodaz.xyz)"
REUNIR_CONTACT_URL="mailto:jesus@jodaz.xyz"

# --- Upstream base URLs (Cycle 1) ---
SOURCE_A_BASE_URL="https://desaparecidos-terremoto-api.theempire.tech"
SOURCE_C_BASE_URL="https://terremotovenezuela.app"
# Source B is "not connected" by design (ADR 0001) — no base URL, no Turnstile automation.

# --- Server-side politeness cache (Cycle 3) ---
# When the Upstash REST URL+token are set, the cache uses Upstash (durable, shared across
# Worker isolates). Unset = in-memory fallback so the app runs locally with no creds.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
CACHE_TTL_SECONDS="60"

# --- Outbound politeness: timeout / retry / circuit breaker (Cycle 3) ---
UPSTREAM_TIMEOUT_MS="8000"          # per-attempt request timeout
UPSTREAM_MAX_ATTEMPTS="3"           # total attempts per call (1 = no retry)
UPSTREAM_BACKOFF_BASE_MS="200"      # exponential backoff base (full jitter applied)
UPSTREAM_BACKOFF_MAX_MS="2000"      # backoff ceiling (also clamps honored Retry-After)
BREAKER_FAILURE_THRESHOLD="5"       # consecutive transient failures that trip OPEN
BREAKER_COOLDOWN_MS="15000"         # OPEN cooldown before a HALF_OPEN probe

# --- Self-protection: token gate / rate limit ---
# The gate is FAIL-CLOSED by default: with the secrets below unset it REFUSES to serve, UNLESS
# you explicitly opt out for local dev with GATE_DISABLED=1. Absence of a signal never means open.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
SESSION_TOKEN_SECRET=""
# Optional Turnstile action: when set, the widget sends it and siteverify must echo it.
TURNSTILE_ACTION=""
# Local-dev ONLY: set to "1" to run WITHOUT the gate when no secrets are configured.
# Never set this in production.
GATE_DISABLED=""
# REQUIRED in production (no default there): the app's public origin. Unset in prod → the app
# throws rather than 403-ing every real same-origin relative via a stale localhost default.
ALLOWED_ORIGIN="http://localhost:3000"
RATE_LIMIT_PER_MIN="30"
# NOTE: in production with the gate ACTIVE, the rate-limit store (Upstash, the UPSTASH_* vars
# above) is REQUIRED — the in-memory limiter is per-isolate and silently inert across the fleet.
# IP keying trusts ONLY cf-connecting-ip in production (Cloudflare-set); x-forwarded-for is ignored.

# --- Server-enforced caps (PRD §5.4) ---
MAX_PAGE_SIZE="48"
