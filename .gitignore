# dependencies
/node_modules
.pnp
.pnp.*

# next.js / build
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# env / secrets — NEVER commit real keys. .env.local holds local test/dev secrets
# (Upstash, Turnstile, session secret); the .env*.local glob already covers it, listed
# explicitly here as a safeguard.
.env
.env*.local
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
.vercel
/coverage

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

!.env.example
